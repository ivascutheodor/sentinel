# This is an example .env file for the Sentinel backend application.
# You can copy this file to .env and modify the values as needed.

# ---------------------------
# Application settings
# ---------------------------
APP_NAME=Sentinel
DEBUG=True
ENVIRONMENT=development

# ---------------------------
# API settings
# ---------------------------
API_PREFIX=/api/v1
# Browser origins allowed to call the API with cookies (JSON list). Not needed when the
# frontend goes through the Vite proxy. Add the exact frontend URL you open through
# Tailscale or your private network, e.g. "http://homie:5173".
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ---------------------------
# Database settings
# ---------------------------
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# ---------------------------
# Auth settings
# ---------------------------
# Long random string; the worker's SENTINEL_API_KEY must match it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_API_KEY=
# Set to True when the API is served over HTTPS
SESSION_COOKIE_SECURE=False
