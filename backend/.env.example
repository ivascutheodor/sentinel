# This is an example .env file for the Sentinel backend application.
# You can copy this file to .env and modify the values as needed.

# ---------------------------
# Application settings
# ---------------------------
APP_NAME=Sentinel
DEBUG=True
ENVIRONMENT=development

# ---------------------------
# API settings
# ---------------------------
API_PREFIX=/api/v1

# ---------------------------
# Database settings
# ---------------------------
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432