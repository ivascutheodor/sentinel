# Sentinel Worker Configuration

# ---------------------------
# Video source settings
# ---------------------------
# Path to a video file, camera index (0, 1, ...), or RTSP stream URL
SENTINEL_VIDEO_SOURCE=clips/incident_2026-09-28_14-44-32.mp4

# Path to the zone polygon configuration (JSON file)
SENTINEL_ZONE_CONFIG=src/config_zona.json

# Path to the YOLO model file
SENTINEL_MODEL=yolo11n.pt

# Directory where incident clips are saved
SENTINEL_CLIPS_DIR=clips

# ---------------------------
# Recording settings
# ---------------------------
# Number of seconds to buffer before an incident (pre-roll)
SENTINEL_PRE_ROLL_SECONDS=5

# Number of seconds to record after last detection (post-roll)
SENTINEL_POST_ROLL_SECONDS=5

# Minimum seconds a person must stay in the zone to trigger recording
SENTINEL_MIN_PRESENCE_SECONDS=2

# ---------------------------
# Display and debug settings
# ---------------------------
# Set to 1 to show the live monitoring window (0 for headless operation)
SENTINEL_SHOW_WINDOW=1

# Set to 1 for verbose debug output
SENTINEL_DEBUG=0
